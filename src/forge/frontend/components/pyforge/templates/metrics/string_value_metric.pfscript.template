@pf.metric(name="My String Value", type="value")
def my_string_metric():
    """
    This function should return a string.
    Useful for displaying states, names, or modes.
    """
    # Example: Get the name of a 'current_level' object
    try:
        current_level = pf.get('current_level')
        return current_level.name
    except (NameError, AttributeError):
        return "N/A"