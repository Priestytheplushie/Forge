# metric_event_script.pfscript.template
# This script runs automatically when a specific metric's value changes.

# The following variables are automatically injected by the 'on_metric_update' hook:
# - metric_path (str): The full path of the metric (e.g., 'system/cpu' or 'custom/My Metric').
# - new_value (any): The new value of the metric.
# - old_value (any): The previous value of the metric.

import pf

pf.log(f"Metric '{metric_path}' changed from {old_value} to {new_value}")

