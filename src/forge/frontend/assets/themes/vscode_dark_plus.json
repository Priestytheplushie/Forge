{
    "name": "VSCode Dark Plus Vibrant",
    "base": "vs-dark",
    "inherit": true,
    "semanticHighlighting": true,
    "rules": [
        {"token": "comment", "foreground": "6A9955", "fontStyle": "italic"},
        {"token": "string", "foreground": "D69D85"}, 
        {"token": "number", "foreground": "B5CEA8"},      
        {"token": "keyword", "foreground": "569CD6", "fontStyle": "bold"},
        {"token": "function", "foreground": "FFD700"},     
        {"token": "method", "foreground": "FFD700"},
        {"token": "class", "foreground": "4EC9B0", "fontStyle": "bold"},
        {"token": "type", "foreground": "4EC9B0"},
        {"token": "parameter", "foreground": "9CDCFE", "fontStyle": "italic"},
        {"token": "variable", "foreground": "9CDCFE"},
        {"token": "property", "foreground": "9CDCFE"},
        {"token": "namespace", "foreground": "4EC9B0"},
        {"token": "magicFunction", "foreground": "FFD700", "fontStyle": "italic"},
        {"token": "selfParameter", "foreground": "9CDCFE"},
        {"token": "clsParameter", "foreground": "9CDCFE"},
        {"token": "decorator", "foreground": "C586C0"},
        {"token": "namespace.defaultLibrary", "foreground": "4EC9B0"},
        {"token": "type.defaultLibrary", "foreground": "4EC9B0"},
        {"token": "function.defaultLibrary", "foreground": "FFD700"},
        {"token": "variable.defaultLibrary", "foreground": "9CDCFE"}
    ],
    "colors": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#F0F0F0",
        "sideBar.background": "#252526",
        "sideBar.border": "#333333",
        "list.activeSelectionBackground": "#37373d",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#2d2d30",
        "list.inactiveSelectionForeground": "#cccccc",
        "editor.selectionBackground": "#264F78AA",       
        "editor.lineHighlightBackground": "#2A2A2A",
        "editorCursor.foreground": "#FFFFFF",
        "editorWhitespace.foreground": "#404040",
        "diffEditor.insertedTextBackground": "#587C0C44",
        "diffEditor.removedTextBackground": "#94151B44",
        "editorIndentGuide.background": "#404040",
        "editorIndentGuide.activeBackground": "#707070",
        "editorBracketMatch.background": "#515C6A44",
        "editorBracketMatch.border": "#FFFFFF"
    }
}